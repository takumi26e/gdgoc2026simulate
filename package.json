{
  "name": "konbini-simulator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "コンビニ立体音響シミュレーター（PC とスマホを連携させて、視覚障害者向けの音の案内を試す）",
  "scripts": {
    "dev": "vite",
