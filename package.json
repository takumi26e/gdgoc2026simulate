    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.170.0",
    "@types/ws": "8.18.2",
    "selfsigned": "5.5.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "ws": "8.22.1"
  }
}
